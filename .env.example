# mai — Environment Configuration
# Copy this file to `.env` and fill in the values for your local environment.

# PostgreSQL database connection string
DATABASE_URL=postgres://mai_user:mai_password@localhost:5432/mai_db

# Application environment: DEV or PROD
MAI_ENV=DEV

# Server address
LEPTOS_OUTPUT_NAME="mai"
LEPTOS_SITE_ROOT="target/site"
LEPTOS_SITE_PKG_DIR="pkg"
LEPTOS_SITE_ADDR="127.0.0.1:3000"
LEPTOS_RELOAD_PORT="3001"

# Session secret (replace with a strong random string in production)
SESSION_SECRET="change-me-to-a-secure-random-string-in-production"
